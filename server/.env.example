PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-farmsense
JWT_SECRET=your_super_secret_key_here
CLIENT_URL=http://localhost:5173

# Anthropic Claude — chat, streaming, vision (disease detection), tool-use (Planting Advisor)
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI — text-embedding-3-small, used only to embed the RAG reference documents
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# OpenWeatherMap — 7-day forecast (free tier works)
# https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-key-here

# data.gov.in — Mandi (market) price records, Agmarknet resource
# https://data.gov.in (free account, generate an API key from "My Account")
DATA_GOV_API_KEY=your-data-gov-in-key-here
